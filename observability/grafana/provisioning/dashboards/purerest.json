{
  "title": "purerest RED + Resilience",
  "uid": "purerest-red-resilience",
  "timezone": "browser",
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (by route)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count[1m])) by (job, http_route)",
          "legendFormat": "{{job}} {{http_route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate (5xx server responses)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[1m])) by (job, http_route)",
          "legendFormat": "{{job}} {{http_route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request Duration (p50 / p95 / p99, server)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_request_duration_seconds_bucket[1m])) by (le, job))",
          "legendFormat": "p50 {{job}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket[1m])) by (le, job))",
          "legendFormat": "p95 {{job}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket[1m])) by (le, job))",
          "legendFormat": "p99 {{job}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "Client Call Duration (order-service -> inventory-service, p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_client_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 client call",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Retry Attempts by Outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(purerest_retry_attempts_total[1m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Circuit Breaker: State Transitions & Rejections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(purerest_circuit_breaker_state_transitions_total[1m])) by (from_state, to_state)",
          "legendFormat": "{{from_state}} -> {{to_state}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(purerest_circuit_breaker_calls_rejected_total[1m]))",
          "legendFormat": "rejected",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "Circuit Breaker: Current State",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "purerest_circuit_breaker_state == 1",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "order-service DB Query Duration (p95, by operation)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(db_client_operation_duration_seconds_bucket[1m])) by (le, db_operation))",
          "legendFormat": "p95 {{db_operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "order-service DB Error Rate (by operation)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(db_client_operation_duration_seconds_count{error_type!=\"\"}[1m])) by (db_operation, error_type)",
          "legendFormat": "{{db_operation}} ({{error_type}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Circuit Breaker: State Timeline",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "expr": "purerest_circuit_breaker_state",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Retry Success Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(purerest_retry_attempts_total{outcome=\"succeeded\"}[1m])) / (sum(rate(purerest_retry_attempts_total{outcome=\"succeeded\"}[1m])) + sum(rate(purerest_retry_attempts_total{outcome=\"exhausted\"}[1m])))",
          "legendFormat": "success rate (incl. retried)",
          "refId": "A"
        }
      ]
    }
  ]
}
